# Database Connection URI (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# JWT Authentication Configuration
SECRET_KEY=generate_a_secure_random_string_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS origins (comma-separated). Use specific origins in production.
CORS_ORIGINS=http://localhost:3000

# Data Encryption Key (Decoupled Fernet key for stored credentials)
ENCRYPTION_KEY=generate_a_separate_secure_encryption_key_for_production
